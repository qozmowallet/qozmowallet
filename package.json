{
  "name": "qozmo-wallet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "privacy:setup": "node scripts/privacy-setup.mjs",
    "privacy:test": "node --import tsx scripts/privacy-e2e.mjs",
    "privacy:deploy": "node --import tsx scripts/privacy-deploy.mjs",
    "privacy:verify": "node --import tsx scripts/privacy-verify.mjs",
    "privacy:demo": "node --import tsx scripts/privacy-demo.mjs",
    "privacy:demo:test": "node --import tsx scripts/privacy-demo-test.mjs",
    "wallet:unified:test": "npm run build:privacy && node --import tsx scripts/unified-wallet-test.mjs",
    "dev": "npm run build:privacy && node scripts/dev.mjs",
    "build:privacy": "node scripts/build-privacy-prover.mjs",
    "build": "npm run build:privacy && npm run build:extension && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "gateway": "node --env-file-if-exists=.env.local scripts/gateway.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "verify:extension": "node --import tsx scripts/verify-extension.ts",
    "verify:wots": "node --import tsx scripts/verify-wots.ts",
    "verify:qzo": "node --import tsx scripts/check-qzo-token.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@solana-program/system": "0.16.0",
    "@solana/kit": "8.6.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "poseidon-lite": "0.3.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "esbuild": "0.28.2",
    "ffjavascript": "0.3.1",
    "jsdom": "28.1.0",
    "snarkjs": "0.7.6",
    "solc": "0.8.38",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "solc": { "tmp": "0.2.7" },
    "snarkjs": { "underscore": "1.13.8" },
    "circomlibjs": { "ws": "8.21.0" }
  }
}
